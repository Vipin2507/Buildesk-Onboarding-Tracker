# SQLite database — use an absolute path on the VPS so deploys never touch the wrong file.
# Local dev:
DATABASE_URL=file:./data/buildesk.db
#
# Production (keep DB outside htdocs; existing companies live here):
# DATABASE_URL=file:/home/buildesk-track/data/buildesk.db

# Or set a directory (VPS): DATA_DIR=/home/buildesk-track/data
# DATA_DIR=

# Cookie session signing secret (change in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Set to true ONLY when the site is served over HTTPS (certbot).
# Leave unset/false for http://IP access — Secure cookies will not stick on HTTP.
# COOKIE_SECURE=true

# Node
NODE_ENV=development

# Client portal links copied in Ticket Tracking (full URL prefix).
# Use your VPS IP or domain — clients open this to create tickets.
# Example: http://69.62.84.237  or  https://track.buildesk.com
VITE_PORTAL_BASE_URL=http://69.62.84.237

# Public app URL (OAuth redirects, absolute links). Example: https://track.buildesk.com
# APP_BASE_URL=http://localhost:3000

# Google Calendar + Meet (CRM Bookings). Create an OAuth client in Google Cloud Console
# with redirect URI matching GOOGLE_REDIRECT_URI (or APP_BASE_URL + /auth/google/calendar/callback).
# Scopes: openid email profile, calendar.events, calendar.freebusy
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/calendar/callback
